{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "audio": ["./src/audio"],
      "components/*": ["./src/components/*"],
      "config/*": ["./src/config/*"],
      "engine": ["./src/engine"],
      "storage": ["./src/storage"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"]
    },
    "typeRoots": ["node_modules/@types", "types"],
    "jsx": "react-jsx",
    "importHelpers": true
  },
  "include": ["src", "types", "config"],
  "exclude": [
    "node_modules"
  ]
}
